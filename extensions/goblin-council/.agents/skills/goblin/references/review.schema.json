{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "verdict",
    "defects",
    "repair_plan",
    "restart_required"
  ],
  "properties": {
    "candidate_id": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "ESCALATE"
      ]
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "path",
          "line",
          "evidence",
          "fix"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocking",
              "advisory"
            ]
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    },
    "repair_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restart_required": {
      "type": "boolean"
    }
  }
}
